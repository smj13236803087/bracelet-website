// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum OrderStatus {
  PENDING_PAYMENT
  PENDING_SHIPMENT
  PENDING_RECEIPT
  COMPLETED
  CANCELLED
}

enum ShopifySyncStatus {
  PENDING
  SYNCED
  FAILED
}

model User {
  id                String   @id @default(cuid())
  email             String   @unique
  password          String
  name              String?
  shopifyCustomerId String?  @unique
  shopifyEmail      String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  braceletDesigns BraceletDesign[]
  orders          Order[]

  @@map("users")
}

model PendingUser {
  email            String   @id
  name             String
  password         String
  verificationCode String
  expiresAt        DateTime
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@map("pending_users")
}

model BraceletDesign {
  id              String   @id @default(cuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id])
  name            String
  totalPrice      Float
  totalWeight     Float?
  averageDiameter Float?
  wristSize       Float?
  wearingStyle    String?
  items           Json
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([userId])
  @@map("bracelet_designs")
}

model Order {
  id                  String            @id @default(cuid())
  userId              String
  user                User              @relation(fields: [userId], references: [id])
  orderNo             String            @unique
  status              OrderStatus       @default(PENDING_PAYMENT)
  designName          String?
  items               Json
  totalPrice          Float
  wristSize           Float?
  wearingStyle        String?
  shopifyDraftOrderId String?
  shopifyOrderId      String?           @unique
  shopifyOrderName    String?
  shopifyCheckoutUrl  String?           @db.Text
  shopifySyncStatus   ShopifySyncStatus @default(PENDING)
  shopifySyncError    String?           @db.Text
  carrier             String?
  trackingNumber      String?
  trackingUrl         String?           @db.Text
  trackingEvents      Json?
  paidAt              DateTime?
  shippedAt           DateTime?
  receivedAt          DateTime?
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt

  @@index([userId])
  @@index([status])
  @@index([shopifyDraftOrderId])
  @@map("orders")
}
